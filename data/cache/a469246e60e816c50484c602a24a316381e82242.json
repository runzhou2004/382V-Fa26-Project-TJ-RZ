n`mvn -pl plugins/rest/ edu.illinois:nondex-maven-plugin:1.1.2:nondex -Dtest=org.apache.struts2.rest.handler.JacksonXmlHandlerTest `,\r\n\r\n`testObjectToXml` method will fail sometimes. This is because `fromObject()` method of `JacksonXmlHandler` uses `com.fasterxml.jackson.dataformat.xml.XmlMapper`, whose marshal strategy that serializes the object is non-deterministic. Thus, the output of `toString()` method of the serialized xml object is non-deterministic. I fixed the bug by checking the output contains all components of the xml object and the expected length.", "labels": [], "milestone": null, "active_lock_reason": null, "created_at": "2021-11-02T03:37:29Z", "updated_at": "2021-11-02T07:08:58Z", "closed_at": "2021-11-02T07:08:58Z", "merged_at": "2021-11-02T07:08:58Z", "merge_commit_sha": "a368cb632895e689f81ec59868b28bbf033d9ef8", "assignee": null, "assignees": [], "requested_reviewers": [], "requested_teams": [], "head": {"label": "FanYuliang:master", "ref": "master", "repo": {"id": 422776983, "node_id": "R_kgDOGTMQlw", "name": "struts", "full_name": "FanYuliang/struts", "owner": {"login": "FanYuliang", "id": 18262867, "node_id": "MDQ6VXNlcjE4MjYyODY3", "avatar_url": "https://avatars.githubusercontent.com/u/18262867?v=4", "gravatar_id": "", "url": "https://api.github.com/users/FanYuliang", "html_url": "https://github.com/FanYuliang", "followers_url": "https://api.github.com/users/FanYuliang/followers", "following_url": "https://api.github.com/users/FanYuliang/following{/other_user}", "gists_url": "https://api.github.com/users/FanYuliang/gists{/gist_id}", "starred_url": "https://api.github.com/users/FanYuliang/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/FanYuliang/subscriptions", "organizations_url": "https://api.github.com/users/FanYuliang/orgs", "repos_url": "https://api.github.com/users/FanYuliang/repos", "events_url": "https://api.github.com/users/FanYuliang/events{/privacy}", "received_events_url": "https://api.github.com/u