emq-stomp%2Fsrc%2Ftest%2Fjava%2Forg%2Fapache%2Factivemq%2Ftransport%2Fstomp%2FSamplePojo.java", "raw_url": "https://github.com/apache/activemq/raw/4e602aad0ef16dfc6a0983598b8fcfa245cdc3d0/activemq-stomp%2Fsrc%2Ftest%2Fjava%2Forg%2Fapache%2Factivemq%2Ftransport%2Fstomp%2FSamplePojo.java", "contents_url": "https://api.github.com/repos/apache/activemq/contents/activemq-stomp%2Fsrc%2Ftest%2Fjava%2Forg%2Fapache%2Factivemq%2Ftransport%2Fstomp%2FSamplePojo.java?ref=4e602aad0ef16dfc6a0983598b8fcfa245cdc3d0", "patch": "@@ -52,4 +52,16 @@ public String getName() {\n     public void setName(String name) {\n         this.name = name;\n     }\n+\n+    //implement equals\n+\n+    @Override\n+    public boolean equals(Object obj) {\n+        if (obj instanceof SamplePojo) {\n+            SamplePojo other = (SamplePojo) obj;\n+            return name.equals(other.name) && city.equals(other.city);\n+        }\n+        return false;\n+    }\n+\n }"}, {"sha": "9f0d65e90921319aadadc4324d48fcc24d5d0ccc", "filename": "activemq-stomp/src/test/java/org/apache/activemq/transport/stomp/StompTest.java", "status": "modified", "additions": 41, "deletions": 6, "changes": 47, "blob_url": "https://github.com/apache/activemq/blob/4e602aad0ef16dfc6a0983598b8fcfa245cdc3d0/activemq-stomp%2Fsrc%2Ftest%2Fjava%2Forg%2Fapache%2Factivemq%2Ftransport%2Fstomp%2FStompTest.java", "raw_url": "https://github.com/apache/activemq/raw/4e602aad0ef16dfc6a0983598b8fcfa245cdc3d0/activemq-stomp%2Fsrc%2Ftest%2Fjava%2Forg%2Fapache%2Factivemq%2Ftransport%2Fstomp%2FStompTest.java", "contents_url": "https://api.github.com/repos/apache/activemq/contents/activemq-stomp%2Fsrc%2Ftest%2Fjava%2Forg%2Fapache%2Factivemq%2Ftransport%2Fstomp%2FStompTest.java?ref=4e602aad0ef16dfc6a0983598b8fcfa245cdc3d0", "patch": "@@ -35,6 +35,9 @@\n import java.util.regex.Matcher;\n import java.util.regex.Pattern;\n \n+import com.fasterxml.jackson.databind.JsonNode;\n+import com.fasterxml.jackson.databind.ObjectMapper;\n+import com.fasterxml.jackson.dataformat.xml.XmlMapper;\n import jakarta.jms.BytesMessage;\n import jakarta.jms.Connection;\n import jakarta.jms.JMSException;\n@@ -1090,7 +1093,7 @@ public void testTransformationSubscribeXML() throws Exception {\n \n         frame = stompConnection.receiveFrame();\n \n-        assertTrue(frame.trim().endsWith(xmlObject));\n+        compareFrameXML(frame, xmlObject);\n     }\n \n     @Test(timeout = 60000)\n@@ -1110,7 +1113,7 @@ public void testTransformationReceiveJSONObject() throws Exception {\n \n         frame = stompConnection.receiveFrame();\n \n-        assertTrue(frame.trim().endsWith(jsonObject));\n+        compareFrameJson(frame, jsonObject);\n     }\n \n     @Test(timeout = 60000)\n@@ -1131,7 +1134,7 @@ public void testTransformationReceiveXMLObject() throws Exception {\n \n         frame = stompConnection.receiveFrame();\n \n-        assertTrue(frame.trim().endsWith(xmlObject));\n+        compareFrameXML(frame, xmlObject);\n     }\n \n     @Test(timeout = 60000)\n@@ -1152,7 +1155,26 @@ public void testTransformationReceiveObject() throws Exception {\n \n         frame = stompConnection.receiveFrame();\n \n-        assertTrue(frame.trim().endsWith(xmlObject));\n+\n+\n+        compareFrameXML(frame, xmlObject);\n+    }\n+\n+    private void compareFrameXML(String frame, String xmlObject) {\n+\n+        String xmlReceived = frame.trim().substring(frame.indexOf(\"<pojo>\"));\n+\n+        try {\n+            //use jackson xml to compare\n+            XmlMapper xmlMapper = new XmlMapper();\n+            SamplePojo pojoReceived = xmlMapper.readValue(xmlReceived, SamplePojo.class);\n+            SamplePojo pojoObject = xmlMapper.readValue(xmlObject, SamplePojo.class);\n+\n+            assertEquals(pojoReceived, pojoObject);\n+        } catch (Exception e) {\n+            fail(\"Exception while comparing XML: \" + e.getMessage());\n+        }\n+\n     }\n \n     @Test(timeout = 60000)\n@@ -1177,7 +1199,7 @@ public void testTransformationReceiveXMLObjectAndMap() throws Exception {\n \n         frame = stompConnection.receiveFrame();\n \n-        assertTrue(frame.trim().endsWith(xmlObject));\n+        compareFrameXML(frame, xmlObject);\n \n         StompFrame xmlFrame = stompConnection.receive();\n \n@@ -1336,7 +1358,20 @@ public void testTransformationNotOverrideSubscription() throws Exception {\n \n         frame = stompConnection.receiveFrame();\n \n-        assertTrue(frame.trim().endsWith(jsonObject));\n+        compareFrameJson(frame, jsonObject);\n+    }\n+\n+    private void compareFrameJson(String frame, String jsonObject) {\n+        String receivedJson = frame.trim().substring(frame.indexOf(\"{\\\"pojo\\\":{\"));\n+        try {\n+            ObjectMapper mapper = new ObjectMapper();\n+            JsonNode pojoReceived = mapper.readTree(receivedJson);\n+            JsonNode pojoObject = mapper.readTree(jsonObject);\n+\n+            assertEquals(pojoReceived, pojoObject);\n+        } catch (Exception e) {\n+            fail(\"Exception while comparing JSON: \" + e.getMessage());\n+        }\n     }\n \n     @Test(timeout = 60000)"}, {"sha": "d407fd5e8953926006f4886a11bc76a2a8d1025f", "filename": "pom.xml", "status": "modified", "additions": 5, "deletions": 0, "changes": 5, "blob_url": "https://github.com/apache/activemq/blob/4e602aad0ef16dfc6a0983598b8fcfa245cdc3d0/pom.xml", "raw_url": "https://github.com/apache/activemq/raw/4e602aad0ef16dfc6a0983598b8fcfa245cdc3d0/pom.xml", "contents_url": "https://api.github.com/repos/apache/activemq/contents/pom.xml?ref=4e602aad0ef16dfc6a0983598b8fcfa245cdc3d0", "patch": "@@ -612,6 +612,11 @@\n         <artifactId>jackson-databind</artifactId>\n         <version>${jackson-version}</version>\n       </dependency>\n+      <dependency>\n+        <groupId>com.fasterxml.jackson.dataformat</groupId>\n+        <artifactId>jackson-dataformat-xml</artifactId>\n+        <version>${jackson-version}</version>\n+      </dependency>\n \n       <!-- Used to configure the activemq logs -->\