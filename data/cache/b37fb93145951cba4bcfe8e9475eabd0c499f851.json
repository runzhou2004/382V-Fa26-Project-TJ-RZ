  && \"json\".equals(params.get(\"format\"));\n+    }\n+\n+    private static boolean isUserInfoRequest(Map<String, String> params) {\n+        return \"query\".equals(params.get(\"action\"))\n+                && \"userinfo\".equals(params.get(\"meta\"))\n+                && \"user\".equals(params.get(\"assert\"))\n+                && \"json\".equals(params.get(\"format\"));\n+    }\n }"}]}}